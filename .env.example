# Copy to .env. Nothing here is required for the ML pipeline.
WANDB_MODE=offline
# WANDB_API_KEY=

# Local stack (docker compose)
S3_ENDPOINT=http://localhost:8333
AWS_ACCESS_KEY_ID=localadmin
AWS_SECRET_ACCESS_KEY=localadmin
ICEBERG_REST_URI=http://localhost:8181
REDIS_URL=redis://localhost:6379/0

# API auth: static key locally, OAuth2 client-credentials JWT in production
OPE_API_KEYS=local-dev-key
# OPE_JWT_ISSUER=https://login.example.com/
# OPE_JWT_AUDIENCE=ope-api
# OPE_JWKS_URL=https://login.example.com/.well-known/jwks.json

# Retention Analyst (optional; without keys a scripted fake model is used)
# ANTHROPIC_API_KEY=
# OPENROUTER_API_KEY=
# LANGSMITH_API_KEY=
# LANGSMITH_PROJECT=ope-retention-analyst
